#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  tmux-agent-send -t TARGET [-p PREFIX] [-n LINES] "message"
  printf '%s\n' "message" | tmux-agent-send -t TARGET [-p PREFIX]
  tmux-agent-send --list

Options:
  -t, --target TARGET   tmux target pane, for example %64 or work:0.2.
                       Defaults to AGENT_TMUX_TARGET if set.
  -p, --prefix PREFIX   Prefix added when the message does not already start
                       with it. Example: "FOR CLAUDE:"
  -n, --lines LINES     Lines of target pane output to show after send.
                       Default: AGENT_TMUX_CAPTURE_LINES or 20. Use 0 to skip.
  -q, --quiet           Do not show recent pane output.
  --list                List panes in the current tmux server.

Environment:
  AGENT_TMUX_SUBMIT_DELAY   Delay between paste and Enter. Default: 0.2.
  AGENT_TMUX_RECEIPT_DELAY  Delay before receipt capture. Default: 0.2.
  AGENT_TMUX_RETRY_LINES    Bottom pane lines checked for unsent input. Default: 5.

Purpose:
  Send a message to any tmux-hosted agent, press Enter in the same command, and
  optionally show a short receipt check. Use this instead of raw tmux send-keys.
EOF
}

target="${AGENT_TMUX_TARGET:-}"
prefix=""
lines="${AGENT_TMUX_CAPTURE_LINES:-20}"
quiet=0
submit_delay="${AGENT_TMUX_SUBMIT_DELAY:-0.2}"
receipt_delay="${AGENT_TMUX_RECEIPT_DELAY:-0.2}"
retry_lines="${AGENT_TMUX_RETRY_LINES:-5}"

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --list)
      tmux list-panes -a -F '#{session_name}:#{window_index}.#{pane_index} #{pane_id} #{pane_title} #{pane_current_path}'
      exit 0
      ;;
    -t|--target)
      target="${2:?missing target}"
      shift 2
      ;;
    -p|--prefix)
      prefix="${2:?missing prefix}"
      shift 2
      ;;
    -n|--lines)
      lines="${2:?missing line count}"
      shift 2
      ;;
    -q|--quiet)
      quiet=1
      shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      printf 'error: unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

if [[ -z "${target}" ]]; then
  printf 'error: target pane is required. Use -t TARGET or AGENT_TMUX_TARGET.\n' >&2
  printf 'hint: run: tmux-agent-send --list\n' >&2
  exit 2
fi

case "${lines}" in
  ''|*[!0-9]*)
    printf 'error: line count must be a non-negative integer: %s\n' "${lines}" >&2
    exit 2
    ;;
esac

case "${retry_lines}" in
  ''|*[!0-9]*)
    printf 'error: retry line count must be a non-negative integer: %s\n' "${retry_lines}" >&2
    exit 2
    ;;
esac

if [[ "$#" -gt 0 ]]; then
  message="$*"
else
  message="$(cat)"
fi

if [[ -z "${message//[[:space:]]/}" ]]; then
  printf 'error: message is empty\n' >&2
  exit 2
fi

if ! tmux display-message -p -t "${target}" '#{pane_id}' >/dev/null 2>&1; then
  printf 'error: tmux pane not found: %s\n' "${target}" >&2
  printf 'hint: run: tmux-agent-send --list\n' >&2
  exit 1
fi

capture_recent() {
  local line_count="${1:-20}"
  tmux capture-pane -t "${target}" -p -S -100 | sed '/^[[:space:]]*$/d' | tail -n "${line_count}"
}

capture_bottom() {
  local line_count="${1:-5}"
  tmux capture-pane -t "${target}" -p | tail -n "${line_count}"
}

contains_paste_placeholder() {
  grep -Eiq '\[[[:space:]]*pasted[[:space:]]+(content|text)[^]]*[0-9][^]]*(chars?|lines?)[^]]*\]'
}

message_probe() {
  local candidate=""
  while IFS= read -r line; do
    if [[ -n "${line//[[:space:]]/}" ]]; then
      candidate="${line}"
    fi
  done <<< "${payload}"
  printf '%s' "${candidate:0:120}"
}

looks_unsent() {
  local bottom_capture="${1}"
  if [[ -n "${probe}" ]] && grep -Fq -- "${probe}" <<< "${bottom_capture}"; then
    return 0
  fi
  if contains_paste_placeholder <<< "${bottom_capture}"; then
    return 0
  fi
  return 1
}

payload="${message}"
if [[ -n "${prefix}" && "${payload}" != "${prefix}"* ]]; then
  payload="${prefix} ${payload}"
fi

probe="$(message_probe)"
buffer_name="agent-send-${$}-${RANDOM}"
printf '%s' "${payload}" | tmux load-buffer -b "${buffer_name}" -
tmux paste-buffer -b "${buffer_name}" -t "${target}" -p
tmux delete-buffer -b "${buffer_name}" >/dev/null 2>&1 || true
sleep "${submit_delay}"
tmux send-keys -t "${target}" Enter
sleep "${receipt_delay}"
post_submit_bottom="$(capture_bottom "${retry_lines}")"

if [[ "${retry_lines}" != "0" ]] && looks_unsent "${post_submit_bottom}"; then
  tmux send-keys -t "${target}" Enter
  sleep "${receipt_delay}"
  printf 'submitted: %s (retried Enter once because message or paste placeholder still appeared near pane input)\n' "${target}"
else
  printf 'submitted: %s\n' "${target}"
fi

if [[ "${quiet}" -eq 0 && "${lines}" != "0" ]]; then
  printf '%s\n' '--- recent target pane output ---'
  capture_recent "${lines}"
fi
